# PostgreSQL Configuration for Task Service
# WARNING: Replace these with strong, unique credentials before deployment
POSTGRES_TASK_USER=task_user
POSTGRES_TASK_PW=CHANGE_ME_task_secure_password
POSTGRES_TASK_DB=task_db

# PostgreSQL Configuration for Billing Service
# WARNING: Replace these with strong, unique credentials before deployment
POSTGRES_BILLING_USER=billing_user
POSTGRES_BILLING_PW=CHANGE_ME_billing_secure_password
POSTGRES_BILLING_DB=billing_db

# RabbitMQ Configuration
# WARNING: Replace these with strong, unique credentials before deployment
RABBITMQ_DEFAULT_USER=CHANGE_ME_rabbitmq_user
RABBITMQ_DEFAULT_PASS=CHANGE_ME_rabbitmq_secure_password
